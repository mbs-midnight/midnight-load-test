# Copy to .env.stagenet (gitignored) and fill in. The seed funds the test wallet;
# treat it as a spend key.
MN_STAGENET_SEED=<32- or 64-byte hex seed, or a BIP39 mnemonic>
# Optional overrides (defaults are the public stagenet endpoints and a local proof server on :6310)
#MN_INDEXER_HTTP=https://indexer.stagenet.shielded.tools/api/v4/graphql
#MN_INDEXER_WS=wss://indexer.stagenet.shielded.tools/api/v4/graphql/ws
#MN_NODE_RPC=wss://rpc.stagenet.shielded.tools
#MN_PROOF_SERVER=http://localhost:6310
#MN_TTL_MS=3600000
#MN_FEE_BLOCKS_MARGIN=2
#MN_PRIVATE_STATE_PASSWORD=<>=16 chars, 3 of 4 character classes; only for mint.ts>
