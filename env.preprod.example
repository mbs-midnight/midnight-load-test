# Copy to .env.preprod (gitignored) and fill in. Everything here is a secret or
# selects a network; nothing in it is logged.
MN_NETWORK=preview
# Exactly one of the two:
MIDNIGHT_PREPROD_MNEMONIC=<BIP39 mnemonic of the funding wallet>
#MIDNIGHT_PREPROD_SEED=<hex seed>
# Rate-limit bypass for the hosted indexer/node, if you have been issued one.
# Injected by indexer_proxy.mjs; never printed.
#MN_RATELIMIT_HEADER=<header name>
#MN_RATELIMIT_BYPASS=<token>
# Hosted proof server (Arkhia) credentials, only for proxy.mjs
#ARKHIA_API_KEY=
#ARKHIA_API_SECRET=
# Endpoint overrides, normally left to the network defaults
#MN_INDEXER_HTTP=
#MN_INDEXER_WS=
#MN_NODE_RPC=
#MN_PROOF_SERVER=http://localhost:6300
#MN_PROOF_SERVERS=http://127.0.0.1:6300/,http://127.0.0.1:6302/
